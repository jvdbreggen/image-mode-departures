[Unit]
Description=Train Tickets Departure Board (Vite Dev Server)
After=network.target systemd-tmpfiles-setup.service

[Service]
Type=simple
WorkingDirectory=/usr/share/train-tickets/departures
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/node /usr/share/train-tickets/departures/node_modules/vite/bin/vite.js --host 0.0.0.0
Restart=on-failure
RestartSec=5

EnvironmentFile=-/etc/train-tickets/departures.env

[Install]
WantedBy=multi-user.target